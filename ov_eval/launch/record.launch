<launch>
    <arg name="topic"       default="/uav1/estimation_manager/estimation" />

    <arg name="path_save"   default="/home/carrara" />

    <node name="recorder_estimate" pkg="ov_eval" exec="pose_to_file" output="screen">
        <param name="topic"      value="$(var topic)" />
        <param name="topic_type" value="Odometry" />
        <param name="output"     value="$(var path_save)/$(var topic).txt" />
    </node>

</launch>
